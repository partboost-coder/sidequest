# Sidequest environment variables. Copy to .env.local and fill in.
# Server-only values are never exposed to the browser; only NEXT_PUBLIC_* values are.

# --- Qloo -------------------------------------------------------------------
# mock   = fixture-backed client, no key needed (default)
# real   = live Qloo hackathon API
# record = live API, and responses are saved as fixtures
QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Mapbox -----------------------------------------------------------------
# Secret token (server): Directions + Geocoding.
MAPBOX_TOKEN=
# Public token (browser): map rendering. Restrict it to your localhost and Vercel URLs.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Sessions / Supabase ----------------------------------------------------
# supabase = anonymous guest sessions (intended architecture)
# dev      = fixed seeded user (temporary fallback; needs DEV_USER_ID)
SESSION_MODE=supabase
DEV_USER_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional until persistence lands (v0.2.0). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (from v0.3.0) ------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Feature flags (P1 items; default off) ----------------------------------
FEATURE_AUTH_UI=false
FEATURE_PUBLIC_RECAP=false
FEATURE_REPLAN_CHAT=false
FEATURE_HOTELS=false
FEATURE_PHOTO_UPLOAD=false
FEATURE_XP_LEVELS=false
FEATURE_REGENERATE_DAY=false
