{
  "name": "sidequest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "qloo:verify": "tsx --env-file=.env.local scripts/qloo-verify.ts",
    "qloo:favorites": "tsx --env-file=.env.local scripts/pick-favorites.ts",
    "qloo:scan-demo": "tsx --env-file=.env.local scripts/scan-demo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mapbox/polyline": "^1.2.1",
    "@turf/turf": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "mapbox-gl": "^3.32.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.26.1",
  "description": "Sidequest: the road trip built around your taste. Agentic, Qloo-powered road-trip companion.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  }
}
